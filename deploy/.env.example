APP_DOMAIN=trpg.example.com
VOICE_DOMAIN=voice.trpg.example.com
ACME_EMAIL=admin@example.com
PUBLIC_IP=203.0.113.10
# Optional. Leave empty to derive web origin from APP_DOMAIN while keeping native app origins.
CORS_ORIGINS=

LIVEKIT_URL=wss://voice.trpg.example.com
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-random-secret
VERIFICATION_CODE_SECRET=replace-with-random-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-password
SMTP_FROM=no-reply@example.com
EMAIL_FROM_NAME=夜航跑团桌
SMTP_TIMEOUT_MS=10000

# Prefer Cloud Mail for production verification-code delivery.
# Leave CLOUD_MAIL_TOKEN empty when using email/password login.
CLOUD_MAIL_BASE_URL=https://mail.your-domain.example
CLOUD_MAIL_EMAIL=no-reply@your-domain.example
CLOUD_MAIL_PASSWORD=replace-with-cloud-mail-password
CLOUD_MAIL_TOKEN=
CLOUD_MAIL_ACCOUNT_ID=
CLOUD_MAIL_FROM=
CLOUD_MAIL_FROM_NAME=夜航跑团桌
CLOUD_MAIL_TIMEOUT_MS=10000

EMAIL_DELIVERY_MODE=
EMAIL_DEBUG_CODE=false
PAOTUAN_DISABLE_DATA_DIR_LOCK=false
