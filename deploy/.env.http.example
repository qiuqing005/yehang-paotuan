APP_DOMAIN=203.0.113.10
VOICE_DOMAIN=203.0.113.10
ACME_EMAIL=admin@example.com
PUBLIC_IP=203.0.113.10
# Optional. Leave empty to derive web origin from APP_DOMAIN while keeping native app origins.
CORS_ORIGINS=

# IP-only HTTP mode is for early server smoke testing.
# Browsers generally require HTTPS for microphone access, so production voice needs a real domain.
LIVEKIT_URL=ws://203.0.113.10:7880
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-random-secret
VERIFICATION_CODE_SECRET=replace-with-random-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-password
SMTP_FROM=no-reply@example.com
EMAIL_FROM_NAME=夜航跑团桌
SMTP_TIMEOUT_MS=10000

# Optional real verification-code delivery through Cloud Mail.
CLOUD_MAIL_BASE_URL=
CLOUD_MAIL_EMAIL=
CLOUD_MAIL_PASSWORD=
CLOUD_MAIL_TOKEN=
CLOUD_MAIL_ACCOUNT_ID=
CLOUD_MAIL_FROM=
CLOUD_MAIL_FROM_NAME=夜航跑团桌
CLOUD_MAIL_TIMEOUT_MS=10000

EMAIL_DELIVERY_MODE=
EMAIL_DEBUG_CODE=false
